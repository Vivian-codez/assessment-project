# Verism AI Backend – Environment Configuration
# Copy this to .env and fill in your values.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
PROJECT_NAME="Verism AI Backend"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# ─── Security & FERPA/GDPR Encryption ────────────────────────────────────────
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=verism_super_secret_jwt_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERPA_ENCRYPTION_KEY=MbGUys4qem_FHtZy_5zx8bBSrxkTI2UWrjnhrFAHcyY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://localhost:8080"]

# ─── Supabase (optional) ──────────────────────────────────────────────────────
# Set USE_SUPABASE=false to run entirely on local Docker PostgreSQL.
# Set USE_SUPABASE=true only if you have an active Supabase project and want to
# use Supabase Auth + PostgREST as a secondary data path.
USE_SUPABASE=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── PostgreSQL / Local Database (Docker) ─────────────────────────────────────
# Start with: docker-compose up -d db
# Stop with:  docker-compose stop db
# Verify:     docker exec verism_postgres pg_isready -U postgres -d verism_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verism_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verism_db

# ─── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Qdrant Vector DB ─────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=verism_submissions

# ─── Local File Storage (replaces Supabase Storage) ──────────────────────────
# Uploaded student submissions are saved here.
UPLOADS_DIR=./uploads

# ─── Google GenAI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Evaluation Thresholds ────────────────────────────────────────────────────
DEFAULT_SIMILARITY_THRESHOLD=90.0
AI_CONTENT_INDICATOR_THRESHOLD=65.0
