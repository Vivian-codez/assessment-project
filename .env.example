# Verism AI – Environment Configuration Template
# Copy this file to .env and configure environment variables before running services.

# ─── Application Mode & Ports ──────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
PROJECT_NAME="Verism AI Backend"
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# ─── Security, Cryptography & Token Lifecycle ──────────────────────────────────
# Secret key used for signing JWT access and refresh tokens (generate with: openssl rand -hex 32)
SECRET_KEY=verism_super_secret_jwt_key_change_in_production_1234567890
# Access token lifespan in minutes (15 minutes per enterprise security standards)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifespan in days (14 days for rotating persistent sessions)
REFRESH_TOKEN_EXPIRE_DAYS=14
# Cookie security parameters (set to true in production over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Mandatory AES-256 Fernet key for encrypting student PII at rest (FERPA/GDPR)
FERPA_ENCRYPTION_KEY=MbGUys4qem_FHtZy_5zx8bBSrxkTI2UWrjnhrFAHcyY=

# ─── CORS Whitelist ────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://localhost:8080"]

# ─── Managed PostgreSQL on Supabase ────────────────────────────────────────────
POSTGRES_SERVER=aws-1-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_secure_database_password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOLER_TRANSACTION_URL=postgresql://postgres.your_project_ref:your_secure_database_password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Supabase Project Metadata ─────────────────────────────────────────────────
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── Connection Pool Resilience Settings ───────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_POOL_PRE_PING=true
DB_KEEPALIVES=1
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5

# ─── Redis & Celery Message Broker ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=verism_submissions

# ─── S3 / MinIO Storage Adapter ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=verism_minio_admin
MINIO_ROOT_PASSWORD=verism_minio_super_secret_password_2026
MINIO_BUCKET=verism-submissions
MINIO_USE_SSL=false
UPLOADS_DIR=./uploads

# ─── Google Gemini API ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Search & Integrity Providers (Optional for Web Plagiarism) ───────────────
SERPER_API_KEY=
BRAVE_API_KEY=
COPYLEAKS_API_KEY=

# ─── Evaluation & Similarity Thresholds ────────────────────────────────────────
DEFAULT_SIMILARITY_THRESHOLD=70.0
AI_CONTENT_INDICATOR_THRESHOLD=65.0
