# ==============================================================================
# Verism AI – Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development.
# When deploying to Vercel, set these environment variables in:
# Vercel Project Dashboard -> Settings -> Environment Variables.

# [CRITICAL IN PRODUCTION]
# Base URL for the FastAPI backend REST API.
# In production on Vercel: Set to your public backend URL (e.g. https://api.verism.ai/api/v1 or https://your-backend.onrender.com/api/v1).
# In local development: Defaults to http://localhost:8000/api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# [OPTIONAL] Supabase Client Configuration
# Set to false (default) because Verism AI uses standard FastAPI JWT authentication.
# Only set to true if you are directly invoking the Supabase JavaScript SDK.
VITE_USE_SUPABASE=false
VITE_SUPABASE_URL=https://uljtqfbkxsqzmboilwvw.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
